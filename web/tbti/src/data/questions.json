        {
          "id": "a",
          "label": "按清单拿下第一处夜景",
          "delta": {
            "xing": -3,
            "qian": 0,
            "xian": 0,
            "ren": 0
          }
        },
        {
          "id": "b",
          "label": "先去附近一个备选点",
          "delta": {
            "xing": -1,
            "qian": 0,
            "xian": 0,
            "ren": 0
