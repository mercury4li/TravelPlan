            "xing": -1,
            "qian": 3,
            "xian": 1,
            "ren": -1
          }
        },
        {
          "id": "c",
          "label": "旁边小店看着也香，撤",
          "delta": {
            "xing": 2,
            "qian": -1,
            "xian": 1,
            "ren": 1
