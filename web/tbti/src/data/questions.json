{
  "questions": [
    {
      "id": "q01",
      "text": "出发前一周，你通常会怎么准备？",
      "options": [
        {
          "id": "a",
          "label": "把每天路线和时间排清楚",
          "delta": {
            "xing": -3,
            "qian": 0,
            "xian": -1,
            "ren": 0
          }
        },
        {
          "id": "b",
          "label": "机酒先定，其他到地再说",
          "delta": {
            "xing": 3,
            "qian": 1,
            "xian": 1,
            "ren": 0
          }
        },
        {
          "id": "c",
          "label": "谁说得有理就跟谁改",
          "delta": {
            "xing": 1,
            "qian": 0,
            "xian": 0,
            "ren": -2
          }
        },
        {
          "id": "d",
          "label": "有目的地就能出发",
          "delta": {
            "xing": 1,
            "qian": 0,
            "xian": 0,
            "ren": 1
          }
        }
      ]
    },
    {
