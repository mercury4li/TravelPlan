            "xing": 3,
            "qian": 1,
            "xian": 3,
            "ren": 0
          }
        },
        {
          "id": "c",
          "label": "先看体力，别玩成渡劫",
          "delta": {
            "xing": 1,
            "qian": 0,
            "xian": 1,
            "ren": 1
          }
