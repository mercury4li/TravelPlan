        {
          "id": "a",
          "label": "证件原件、截图、云盘都备好",
          "delta": {
            "xing": 0,
            "qian": 0,
            "xian": -3,
            "ren": 0
          }
        },
        {
          "id": "b",
          "label": "先确认补办和求助渠道",
          "delta": {
            "xing": 0,
            "qian": 0,
            "xian": -1,
            "ren": 0
          }
        },
        {
          "id": "c",
          "label": "知道该备，但出门前再说",
          "delta": {
            "xing": 0,
            "qian": 0,
            "xian": 1,
            "ren": 0
          }
