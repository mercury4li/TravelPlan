        {
          "id": "a",
          "label": "闹钟拉满，按原计划去",
          "delta": {
            "xing": -3,
            "qian": 0,
            "xian": 0,
            "ren": 0
          }
        },
        {
          "id": "b",
          "label": "先睡，起得来就去",
          "delta": {
            "xing": 1,
            "qian": 0,
            "xian": 0,
            "ren": 0
          }
