            "xing": 0,
            "qian": -3,
            "xian": -1,
            "ren": 0
          }
        },
        {
          "id": "b",
          "label": "来都来了，钱包辛苦了",
          "delta": {
            "xing": 1,
            "qian": 3,
            "xian": 1,
            "ren": 0
          }
        },
        {
          "id": "c",
          "label": "大家想去我就不扫兴",
          "delta": {
            "xing": 0,
            "qian": 1,
            "xian": 0,
            "ren": -2
          }
        },
        {
          "id": "d",
          "label": "砍掉一个不够想去的",
          "delta": {
            "xing": -2,
            "qian": -1,
            "xian": 0,
            "ren": 0
          }
        }
      ]
    },
    {
